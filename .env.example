# Copy this file to .env and fill in your values.

# --- Postgres ---
DATABASE_URL=postgresql://shiptrack:shiptrack@localhost:5432/shiptrack

# --- LLM ---
# LLM_MODE:
#   auto    -> local if LOCAL_BASE_URL is set (default below), else Foundry if configured,
#              else a deterministic offline mock. This is what lets the whole pipeline run
#              with zero external dependencies if nothing below is filled in.
#   local   -> force the local OpenAI-compatible server, error out if LOCAL_BASE_URL unset
#   foundry -> force Microsoft/Azure AI Foundry, error out if not configured
#   mock    -> force the offline mock even if something above is configured
LLM_MODE=auto

# --- Local LLM (default backend — Ollama running a lightweight model) ---
# qwen2.5:3b is small enough to run comfortably on a laptop (M1 Air etc.) with fast
# responses. `gpt-oss:20b` also works (better quality) but is heavy — on modest
# hardware it can peg CPU/GPU for minutes per request, so it's opt-in, not default.
# `ollama pull qwen2.5:3b` then Ollama serves an OpenAI-compatible API at this URL
# automatically (no separate `ollama serve` needed if it's already running as a service).
# Using LM Studio instead? Set LOCAL_BASE_URL=http://localhost:1234/v1 and LOCAL_MODEL to
# whatever name LM Studio's server shows for the loaded model.
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5:3b
LOCAL_API_KEY=ollama

# --- Microsoft/Azure AI Foundry (alternative backend) ---
# Your Foundry project's Azure OpenAI-compatible endpoint, e.g.
#   https://<your-foundry-resource>.openai.azure.com/
# (Azure AI Foundry portal -> your project -> Deployments -> click the deployment -> "Target URI"
# gives you the base; use just the https://<resource>.openai.azure.com/ part here.)
FOUNDRY_ENDPOINT=

# API key for that endpoint (Foundry portal -> your project -> Deployments -> Keys, or
# Azure Portal -> your Azure OpenAI resource -> Keys and Endpoint).
FOUNDRY_API_KEY=

# The deployment name you created in Foundry (not the base model name) — e.g. "gpt-4o-mini".
FOUNDRY_DEPLOYMENT=gpt-4o-mini

# Azure OpenAI REST API version to call. Bump this if your deployment requires a newer one.
FOUNDRY_API_VERSION=2024-10-21

# --- App ---
APP_PORT=8000
LOG_LEVEL=INFO
